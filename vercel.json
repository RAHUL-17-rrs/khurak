{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && VITE_STATIC=1 npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": { "maxDuration": 60, "includeFiles": "backend/{app,data}/**" }
  },
  "rewrites": [
    { "source": "/api/live/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|audio/|demo/|assets/|favicon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/audio/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
